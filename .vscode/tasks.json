{
  // Cursor / VS Code のタスク定義。
  // 起動: Ctrl+Shift+P → "Tasks: Run Task"
  // 既定ビルド（短い学習）: Ctrl+Shift+B
  //
  // 学習の作業ディレクトリは常に isaac-lab/。
  // 現行タスクは YuukiLab-BipedWalk-v0。
  // Python は .vscode/settings.json のインタプリタを使う。
  // 引数は配列で渡すので、PowerShell の行継続（`）は不要。
  "version": "2.0.0",
  "tasks": [
    {
      // 報酬や環境のコードを変えたあとに、editable install をやり直す。
      "label": "Isaac: パッケージを再インストール",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip", "install", "-e", "source/yuuki_isaac_lab"],
      "options": {
        "cwd": "${workspaceFolder}/isaac-lab"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      // 学習ループが起動するかだけ見る。歩行の出来は見ない。Ctrl+Shift+B の既定タスク。
      "label": "Isaac: 短い学習（BipedWalk, 64 env, 5 iter）",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/rsl_rl/train.py",
        "--task",
        "YuukiLab-BipedWalk-v0",
        "--headless",
        "--num_envs",
        "64",
        "--max_iterations",
        "5",
        "--run_name",
        "${input:runName}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/isaac-lab"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      // 本学習。環境数の既定はタスク側の 4096。反復数と run 名は実行時に聞く。
      "label": "Isaac: 本番学習（BipedWalk, 4096 env）",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/rsl_rl/train.py",
        "--task",
        "YuukiLab-BipedWalk-v0",
        "--headless",
        "--num_envs",
        "4096",
        "--max_iterations",
        "${input:maxIterations}",
        "--run_name",
        "${input:runName}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/isaac-lab"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "runName",
      "type": "promptString",
      "description": "run_name（ログ名の接尾辞。例: smoke）",
      "default": "smoke"
    },
    {
      "id": "maxIterations",
      "type": "promptString",
      "description": "max_iterations（本番の学習反復数）",
      "default": "600"
    }
  ]
}
