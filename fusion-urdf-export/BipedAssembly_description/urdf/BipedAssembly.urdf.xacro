<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="BipedAssembly">

  <!-- Materials (shared across all assemblies) -->
  <material name="material">
    <color rgba="0.961 0.961 0.965 1.0"/>
  </material>
  <material name="Lipo">
    <color rgba="0.910 0.678 0.137 1.0"/>
  </material>
  <material name="ABS">
    <color rgba="0.965 0.965 0.953 1.0"/>
  </material>

  <!-- Assembly includes -->
  <xacro:include filename="$(find BipedAssembly_description)/urdf/assemblies/DSSERVO_RDS51150_BodyOnly.urdf.xacro"/>
  <xacro:include filename="$(find BipedAssembly_description)/urdf/assemblies/RDS51150Assembly.urdf.xacro"/>
  <xacro:include filename="$(find BipedAssembly_description)/urdf/assemblies/LegAssembly.urdf.xacro"/>
  <xacro:include filename="$(find BipedAssembly_description)/urdf/assemblies/BipedAssembly.urdf.xacro"/>

  <!-- Instantiate assemblies -->
  <xacro:DSSERVO_RDS51150_BodyOnly prefix=""/>
  <xacro:RDS51150Assembly prefix=""/>
  <xacro:LegAssembly prefix=""/>
  <xacro:BipedAssembly prefix=""/>

  <!-- Mount joints (cross-assembly connections) -->
  <!-- These define how assemblies connect to each other. -->
  <!-- When swapping a dummy assembly with a real part, -->
  <!-- update the include + macro call above, and adjust -->
  <!-- parent/child link names in the mount joint below. -->

  <joint name="left_hip_roll" type="revolute">
    <parent link="PELVIS"/>
    <child link="L_HIP"/>
    <origin xyz="0.035000 0.059300 -0.062500" rpy="-1.570796 0.000000 -3.141593"/>
    <axis xyz="0.000000 0.000000 -1.000000"/>
    <limit lower="-0.698132" upper="0.698132" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="right_hip_roll" type="revolute">
    <parent link="PELVIS"/>
    <child link="R_HIP"/>
    <origin xyz="0.245000 0.059300 -0.062500" rpy="-1.570796 0.000000 -3.141593"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="-0.698132" upper="0.698132" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="left_hip_pitch" type="revolute">
    <parent link="L_HIP"/>
    <child link="L_THIGH"/>
    <origin xyz="-0.030750 0.070000 -0.030750" rpy="-3.141593 1.570796 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="-0.698132" upper="0.698132" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="right_hip_pitch" type="revolute">
    <parent link="R_HIP"/>
    <child link="R_THIGH"/>
    <origin xyz="-0.030750 0.070000 -0.030750" rpy="-3.141593 1.570796 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="-0.698132" upper="0.698132" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="left_ankle_pitch" type="revolute">
    <parent link="L_SHIN"/>
    <child link="L_ANKLE"/>
    <origin xyz="0.000000 -0.289750 0.000100" rpy="0.000000 0.000000 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="-0.698132" upper="0.698132" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="right_ankle_pitch" type="revolute">
    <parent link="R_SHIN"/>
    <child link="R_ANKLE"/>
    <origin xyz="0.000000 -0.289750 0.000100" rpy="0.000000 0.000000 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="-0.698132" upper="0.698132" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="left_ankle_roll" type="revolute">
    <parent link="L_ANKLE"/>
    <child link="L_FOOT"/>
    <origin xyz="-0.032200 -0.091500 -0.025500" rpy="3.141593 1.570796 0.000000"/>
    <axis xyz="0.000000 0.000000 -1.000000"/>
    <limit lower="-0.698132" upper="0.698132" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="right_ankle_roll" type="revolute">
    <parent link="R_ANKLE"/>
    <child link="R_FOOT"/>
    <origin xyz="-0.032200 -0.091500 -0.025500" rpy="3.141593 1.570796 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="-0.698132" upper="0.698132" effort="100.0" velocity="1.00"/>
  </joint>

  <!-- ROS 2 control: generated generic system -->
  <ros2_control name="BipedAssembly_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="cmd_topic">sim/BipedAssembly_system/cmd</param>
      <param name="state_topic">sim/BipedAssembly_system/state</param>
    </hardware>

    <joint name="left_ankle_pitch">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="left_ankle_roll">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="left_hip_pitch">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="left_hip_roll">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_ankle_pitch">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_ankle_roll">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_hip_pitch">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_hip_roll">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>