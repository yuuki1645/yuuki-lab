<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="BipedAssembly_macro">

  <xacro:macro name="BipedAssembly" params="prefix">

    <!-- Links -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="0.025000 -0.125000 0.001500" rpy="0 0 0"/>
        <mass value="0.101250"/>
        <inertia ixx="5.274197e-04" ixy="0.000000e+00" ixz="0.000000e+00"
                 iyy="2.116969e-05" iyz="0.000000e+00" izz="5.484375e-04"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 -1.570796"/>
        <geometry>
          <mesh filename="package://BipedAssembly_description/meshes/BipedAssembly/base_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="material"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 -1.570796"/>
        <geometry>
          <mesh filename="package://BipedAssembly_description/meshes/BipedAssembly/base_link_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}PELVIS">
      <inertial>
        <origin xyz="0.139997 0.087537 -0.018010" rpy="0 0 0"/>
        <mass value="1.677122"/>
        <inertia ixx="6.145379e-03" ixy="6.406489e-08" ixz="-1.526088e-07"
                 iyy="2.216246e-02" iyz="-1.127276e-04" izz="2.044135e-02"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://BipedAssembly_description/meshes/BipedAssembly/PELVIS.dae" scale="1 1 1"/>
        </geometry>
        <material name="ABS"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://BipedAssembly_description/meshes/BipedAssembly/PELVIS_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <!-- Joints (internal to assembly) -->
    <joint name="${prefix}biped_fixed_01" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}PELVIS"/>
      <origin xyz="-0.065000 0.015000 0.003000" rpy="0.000000 0.000000 -1.570796"/>
    </joint>

  </xacro:macro>

</robot>