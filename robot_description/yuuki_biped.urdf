  <!-- IMU 候補の参照フレーム。位置は未確認。質量はほぼゼロ。 -->
  <joint name="imu_fixed" type="fixed">
    <parent link="basket"/>
    <child link="imu_link"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
  </joint>
  <!-- 左股ロール。カゴ底面から股ロール軸まで。 -->
  <joint name="left_hip_roll" type="revolute">
    <parent link="basket"/>
    <child link="left_hip"/>
    <origin xyz="0 0.09 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.785398" upper="0.785398" effort="14.7" velocity="8"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <!-- 左股ピッチ。股ロール軸からサーボ1段分だけ下。 -->
  <joint name="left_hip_pitch" type="revolute">
    <parent link="left_hip"/>
    <child link="left_thigh"/>
    <origin xyz="0 0 -0.065" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.785398" upper="1.570796" effort="14.7" velocity="8"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <!-- 左膝。0 が伸び、正が後ろへの屈曲。 -->
  <joint name="left_knee_pitch" type="revolute">
    <parent link="left_thigh"/>
    <child link="left_shin"/>
    <origin xyz="0 0 -0.226" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.094395" effort="14.7" velocity="8"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <!-- 左足首ピッチ。膝から腿と同じ軸間距離だけ下。 -->
  <joint name="left_ankle_pitch" type="revolute">
    <parent link="left_shin"/>
    <child link="left_ankle"/>
    <origin xyz="0 0 -0.226" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.785398" upper="0.785398" effort="14.7" velocity="8"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <!-- 左足首ロール。足首ピッチ軸からサーボ1段分だけ下。 -->
  <joint name="left_ankle_roll" type="revolute">
    <parent link="left_ankle"/>
    <child link="left_foot"/>
    <origin xyz="0 0 -0.065" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.523599" upper="0.523599" effort="14.7" velocity="8"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <!-- 左足裏の下面中心。接触や接地判定の参照点。板の質量は left_foot 側。 -->
  <joint name="left_sole_fixed" type="fixed">
    <parent link="left_foot"/>
    <child link="left_sole"/>
    <origin xyz="0.05 0 -0.04" rpy="0 0 0"/>
  </joint>
  <!-- 右股ロール。カゴ底面から股ロール軸まで。 -->
  <joint name="right_hip_roll" type="revolute">
    <parent link="basket"/>
    <child link="right_hip"/>
    <origin xyz="0 -0.09 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.785398" upper="0.785398" effort="14.7" velocity="8"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <!-- 右股ピッチ。股ロール軸からサーボ1段分だけ下。 -->
  <joint name="right_hip_pitch" type="revolute">
    <parent link="right_hip"/>
    <child link="right_thigh"/>
    <origin xyz="0 0 -0.065" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.785398" upper="1.570796" effort="14.7" velocity="8"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <!-- 右膝。0 が伸び、正が後ろへの屈曲。 -->
  <joint name="right_knee_pitch" type="revolute">
    <parent link="right_thigh"/>
    <child link="right_shin"/>
    <origin xyz="0 0 -0.226" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.094395" effort="14.7" velocity="8"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <!-- 右足首ピッチ。膝から腿と同じ軸間距離だけ下。 -->
  <joint name="right_ankle_pitch" type="revolute">
    <parent link="right_shin"/>
    <child link="right_ankle"/>
    <origin xyz="0 0 -0.226" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.785398" upper="0.785398" effort="14.7" velocity="8"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <!-- 右足首ロール。足首ピッチ軸からサーボ1段分だけ下。 -->
  <joint name="right_ankle_roll" type="revolute">
    <parent link="right_ankle"/>
    <child link="right_foot"/>
    <origin xyz="0 0 -0.065" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.523599" upper="0.523599" effort="14.7" velocity="8"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <!-- 右足裏の下面中心。接触や接地判定の参照点。板の質量は right_foot 側。 -->
  <joint name="right_sole_fixed" type="fixed">
    <parent link="right_foot"/>
    <child link="right_sole"/>
    <origin xyz="0.05 0 -0.04" rpy="0 0 0"/>
  </joint>
</robot>
