        </yuuki_biped/Geometry/basket/right_hip/right_thigh/right_shin/right_ankle>,
        </yuuki_biped/Geometry/basket/right_hip/right_thigh/right_shin/right_ankle/right_foot>,
        </yuuki_biped/Geometry/basket/right_hip/right_thigh/right_shin/right_ankle/right_foot/right_sole>,
    ]
    token isaac:robotType = "Default"

