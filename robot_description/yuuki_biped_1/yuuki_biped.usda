def Xform "yuuki_biped" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
}

over "Flattened_Prototype_57"
{
    def Shader "PreviewSurface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </Flattened_Prototype_57.inputs:diffuseColor>
        float inputs:metallic.connect = </Flattened_Prototype_57.inputs:metallic>
        float inputs:opacity.connect = </Flattened_Prototype_57.inputs:opacity>
        float inputs:roughness.connect = </Flattened_Prototype_57.inputs:roughness>
        token outputs:displacement
        token outputs:surface
    }
}

